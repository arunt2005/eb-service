# Build output
/build/
/.gradle/
/out/

# Gradle wrapper
!gradle/wrapper/gradle-wrapper.jar

# IDEs

## IntelliJ
.idea/
*.iml
*.iws
*.ipr

## Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

## NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

## VS Code
.vscode/

# OS-specific
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp

# Help or documentation files
HELP.md

# Exclude nested build/bin/out folders inside src (usually not needed)
!**/src/main/**/bin/
!**/src/test/**/bin/
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/build/
!**/src/test/**/build/
